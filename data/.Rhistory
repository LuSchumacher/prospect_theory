scale_y_continuous(limits = c(-0.1, 1.1), breaks = seq(0, 1, 0.2)) +
scale_color_manual(values = COLOR_PALETTE) +
labs(
x = "Difference in EV",
y = "Proportion of choosing B",
color = "Lottery type"
) +
